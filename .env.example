# Server Configuration
PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/bbosong?schema=public"
NODE_ENV="development"

# JWT & Authentication Configuration
USER_JWT_SECRET="your-user-jwt-secret-key-change-me-in-production"
USER_JWT_EXPIRE="1h"
USER_JWT_AUDIENCE="bbosong-app"
USER_JWT_ISSUER="bbosong-server"
USER_REFRESH_TOKEN_EXPIRE="30d"
REFRESH_TOKEN_HMAC_SECRET="your-refresh-token-hmac-secret-key-change-me-in-production"

# External API Integrations (Infoteam Account & Policy)
INFOTEAM_ACCOUNT_URL="https://api.account.gistory.me/oauth"
POLICY_API_URL="https://policy.example.com/versions"
SERVICE_NAME_FOR_POLICY_VERSION="bbosong"

# Swagger UI & CORS Configuration
API_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
SWAGGER_USER="admin"
SWAGGER_PASSWORD="password123!"
CLIENT_ID="your-gistory-oauth-client-uuid"
SWAGGER_AUTH_URL="https://account.gistory.me/authorize"
SWAGGER_TOKEN_URL="https://api.account.gistory.me/oauth/token"

# Database Encryption Configuration
LOCAL_ENCRYPTION_KEY="your-local-32chars-encryption-key-!!!!"
LOCAL_ENCRYPTION_PEPPER="your-local-pepper-string"

# Web Push VAPID Configuration
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# FCM (native iOS/Android push). Optional: when unset, only Web Push is sent.
# Firebase service-account key JSON (single line) or its base64 encoding. Secret: never commit.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Android notification channel the app creates for push (default: "default").
FCM_ANDROID_CHANNEL_ID="default"

# APNs (iOS Live Activity push). Optional: when any is unset, Live Activity push is disabled.
# APNs auth key (.p8) PEM or its base64 encoding. Secret: never commit.
APNS_KEY_P8=""
# 10-character Key ID of the .p8 key
APNS_KEY_ID=""
# 10-character Apple Developer Team ID
APNS_TEAM_ID=""
# iOS app bundle ID (apns-topic becomes <bundle id>.push-type.liveactivity)
APNS_BUNDLE_ID=""

# Matter Configuration
MATTER_SITES=A:ws://matter-a:5580/ws,B:ws://matter-b:5580/ws

# Official LG ThinQ Connect (disabled unless all four credentials are set)
THINQ_PAT=""
THINQ_COUNTRY_CODE=""
THINQ_CLIENT_ID=""
# Fixed x-api-key from the official ThinQ Connect docs / SDK (not a per-app secret).
# Example: v6GFvkweNo7DK7yD3ylIZ9w52aKBU0eJ7wLXkSR3
THINQ_API_KEY=""
# Korean / Asian regional server; America: api-aic, Europe / Middle East / Africa: api-eic
THINQ_BASE_URL="https://api-kic.lgthinq.com"
# Sparse REST reconcile for DRY machines only (MQTT carries live updates).
# Seconds; default 600, minimum 300, maximum 86400. Values outside 300-86400 fall back to 600.
# Device list still refreshes every 15 minutes. Keep THINQ_CLIENT_ID stable for MQTT.
THINQ_POLL_INTERVAL_SECONDS=600

# Shlink machine registration links
SHLINK_URL="https://s.example.com"
SHLINK_API_KEY="your-shlink-api-key"
SHLINK_DOMAIN="s.example.com"
MACHINE_REGISTER_URL="https://bbosong.gistory.me/machine-register"

# Slack Incoming Webhook for admin alerts (machine offline). Optional: when unset, Slack alerts are disabled. Secret: never commit.
SLACK_WEBHOOK_URL=""

# Delete machine_power rows older than this many days (checked daily at 03:00). Default 30, minimum 1.
MACHINE_POWER_RETENTION_DAYS=30
