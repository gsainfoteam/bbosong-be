# Server Configuration
PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/bbosong?schema=public"
NODE_ENV="development"

# JWT & Authentication Configuration
USER_JWT_SECRET="your-user-jwt-secret-key-change-me-in-production"
USER_JWT_EXPIRE="1h"
USER_JWT_AUDIENCE="bbosong-app"
USER_JWT_ISSUER="bbosong-server"
USER_REFRESH_TOKEN_EXPIRE="30d"
REFRESH_TOKEN_HMAC_SECRET="your-refresh-token-hmac-secret-key-change-me-in-production"

# External API Integrations (Infoteam Account & Policy)
INFOTEAM_ACCOUNT_URL="https://api.account.gistory.me/oauth"
POLICY_API_URL="https://policy.example.com/versions"
SERVICE_NAME_FOR_POLICY_VERSION="bbosong"

# Swagger UI & CORS Configuration
API_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
SWAGGER_USER="admin"
SWAGGER_PASSWORD="password123!"
CLIENT_ID="your-gistory-oauth-client-uuid"
SWAGGER_AUTH_URL="https://account.gistory.me/authorize"
SWAGGER_TOKEN_URL="https://api.account.gistory.me/oauth/token"

# Database Encryption Configuration
LOCAL_ENCRYPTION_KEY="your-local-32chars-encryption-key-!!!!"
LOCAL_ENCRYPTION_PEPPER="your-local-pepper-string"

# Web Push VAPID Configuration
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Matter Configuration
MATTER_SITES=A:ws://matter-a:5580/ws,B:ws://matter-b:5580/ws

# Official LG ThinQ Connect (disabled unless all four credentials are set)
THINQ_PAT=""
THINQ_COUNTRY_CODE=""
THINQ_CLIENT_ID=""
# Use the fixed x-api-key published in the official ThinQ Connect API documentation.
THINQ_API_KEY=""
# Korean / Asian regional server; America: api-aic, Europe / Middle East / Africa: api-eic
THINQ_BASE_URL="https://api-kic.lgthinq.com"
# Seconds; default/minimum 60, maximum 86400. Device list refreshes every 15 minutes.
THINQ_POLL_INTERVAL_SECONDS=60

# Shlink machine registration links
SHLINK_URL="https://s.example.com"
SHLINK_API_KEY="your-shlink-api-key"
SHLINK_DOMAIN="s.example.com"
MACHINE_REGISTER_URL="https://bbosong.gistory.me/machine-register"
