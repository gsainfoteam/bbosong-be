// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY

  @@map("consent_type")
}

enum Role {
  USER

  @@map("role")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum Location {
  A
  B

  @@map("location")
}

enum MachineType {
  WASHER
  DRYER

  @@map("machine_type")
}

model User {
  uuid          String    @id @db.Uuid
  name          String
  email         String
  studentNumber String    @unique @map("student_number")
  gender        Gender    @map("gender")
  role          Role      @default(USER)
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  usingMachines            UsingMachine[]
  userRefreshTokens        UserRefreshToken[]
  userConsents             UserConsent[]
  auditLogs                AuditLog[]
  pushSubscriptions        UserPushSubscription[]
  laundryRoomSubscriptions LaundryRoomSubscription[]
  machineSubscriptions     MachineSubscription[]

  @@map("user")
}

model UserRefreshToken {
  uuid         String   @id @default(uuid()) @db.Uuid
  userUuid     String   @map("user_uuid") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  sessionId    String   @map("session_id")
  createdAt    DateTime @default(now()) @map("created_at")
  expiredAt    DateTime @map("expired_at")

  user User @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@index([userUuid, sessionId])
  @@map("user_refresh_token")
}

model UserConsent {
  uuid        String      @id @default(uuid()) @db.Uuid
  userUuid    String      @map("user_uuid") @db.Uuid
  consentType ConsentType @map("consent_type")
  version     String
  agreedAt    DateTime    @default(now()) @map("agreed_at")

  user User @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@index([userUuid, consentType])
  @@map("user_consent")
}

model AuditLog {
  uuid   String @id @default(uuid()) @db.Uuid
  action String
  data   String

  userUuid    String?  @map("user_uuid") @db.Uuid
  performedAt DateTime @default(now()) @map("performed_at")

  user User? @relation(fields: [userUuid], references: [uuid], onDelete: SetNull)

  @@index([performedAt])
  @@index([userUuid])
  @@map("audit_log")
}

model Machine {
  uuid        String      @id @default(uuid()) @db.Uuid
  type        MachineType @map("type")
  location    Location    @map("location")
  gender      Gender      @map("gender")
  index       Int         @map("index")
  isAvailable Boolean     @default(true) @map("is_available")
  posX        Int?        @map("pos_x")
  posY        Int?        @map("pos_y")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  currentUsage  UsingMachine?
  subscriptions MachineSubscription[]
  power         MachinePower[]

  @@unique([location, gender, type, index])
  @@index([location, gender])
  @@map("machine")
}

model UsingMachine {
  uuid            String   @id @default(uuid()) @db.Uuid
  machineUuid     String   @unique @map("machine_uuid") @db.Uuid
  userUuid        String   @map("user_uuid") @db.Uuid
  startedAt       DateTime @default(now()) @map("started_at")
  durationMinutes Int      @map("duration_minutes")

  machine Machine @relation(fields: [machineUuid], references: [uuid], onDelete: Cascade)

  user User @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@index([userUuid])
  @@map("using_machine")
}

model MachinePower {
  uuid        String   @id @default(uuid()) @db.Uuid
  machineUuid String   @map("machine_uuid") @db.Uuid
  power       Float    @map("power")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  machine Machine @relation(fields: [machineUuid], references: [uuid], onDelete: Cascade)

  @@index([machineUuid, recordedAt])
  @@map("machine_power")
}

model UserPushSubscription {
  uuid      String   @id @default(uuid()) @db.Uuid
  userUuid  String   @map("user_uuid") @db.Uuid
  endpoint  String   @unique @map("endpoint")
  p256dh    String   @map("p256dh")
  auth      String   @map("auth")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@index([userUuid])
  @@map("user_push_subscription")
}

model LaundryRoomSubscription {
  uuid      String      @id @default(uuid()) @db.Uuid
  userUuid  String      @map("user_uuid") @db.Uuid
  location  Location    @map("location")
  gender    Gender      @map("gender")
  type      MachineType @map("type")
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@index([userUuid])
  @@index([location, gender, type])
  @@map("laundry_room_subscription")
}

model MachineSubscription {
  uuid        String   @id @default(uuid()) @db.Uuid
  userUuid    String   @map("user_uuid") @db.Uuid
  machineUuid String   @map("machine_uuid") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  machine Machine @relation(fields: [machineUuid], references: [uuid], onDelete: Cascade)

  @@index([userUuid])
  @@index([machineUuid])
  @@map("machine_subscription")
}
